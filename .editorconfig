# 仓库缩进权威配置：4 空格
# 编辑器需装 EditorConfig 扩展；oxfmt 直接读取本文件
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# 行宽只约束代码，避免 oxfmt 重排 Markdown 散文与 HTML
[*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,vue,css,scss,sass,less,styl,json,jsonc}]
max_line_length = 100

# Markdown 硬换行依赖行尾空格
[*.md]
trim_trailing_whitespace = false
